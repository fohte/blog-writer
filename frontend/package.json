{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#*": {
      "types": [
        "./src/*.tsx",
        "./src/*.ts",
        "./src/*"
      ],
      "default": "./src/*"
    }
  },
  "scripts": {
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "dev": "vite",
    "api:generate": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.gen.d.ts",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:screenshot": "bash ./scripts/storybook-screenshot.sh",
    "storybook:screenshot:desktop": "vitest run --config vitest.screenshot.config.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@base-ui/react": "1.3.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fohte/ui": "0.1.7",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "neverthrow": "8.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0",
    "uuid": "14.0.3",
    "y-codemirror.next": "0.3.6",
    "y-indexeddb": "9.0.12",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@fohte/storybook-addon": "0.2.0",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@storycap-testrun/browser": "3.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "reg-publish-s3-plugin": "0.14.4",
    "reg-simple-keygen-plugin": "0.14.2",
    "reg-suit": "0.14.5",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
