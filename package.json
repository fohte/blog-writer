{
  "name": "blog-writer",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@fohte/eslint-config": "0.5.1",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.2",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.11.0",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
