#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

docker compose up -d --wait db

current_database_name=''

drop_database() {
  if [[ -z "$current_database_name" ]]; then
    return 0
  fi

  docker compose exec -T db dropdb \
    --username "blog_writer" \
    --if-exists \
    --force \
    "$current_database_name"
  current_database_name=''
}

cleanup() {
  local exit_code=$?
  local cleanup_code=0
  trap - EXIT INT TERM

  drop_database || cleanup_code=$?

  if [[ "$exit_code" -ne 0 ]]; then
    exit "$exit_code"
  fi
  exit "$cleanup_code"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

run_db_doc() {
  local package="$1"
  local package_type="$2"
  local migration_command
  migration_command="$(cat)"

  if [[ "$package_type" == 'node' && "$migration_command" == 'pnpm run db:migrate' ]]; then
    if ! node -e '
      const { readFileSync } = require("node:fs")
      const packageJSON = JSON.parse(readFileSync(process.argv[1], "utf8"))
      process.exit(packageJSON.scripts?.["db:migrate"] ? 0 : 1)
    ' "$package/package.json"; then
      printf 'Skipping database documentation for %s: no db:migrate script\n' "$package" >&2
      return 0
    fi
  elif [[ "$package_type" == 'rust' && "$migration_command" == 'cargo run -q -p migration -- up' && ! -f "$package/migration/Cargo.toml" ]]; then
    printf 'Skipping database documentation for %s: no migration crate\n' "$package" >&2
    return 0
  fi

  if [[ "$package" == "." ]]; then
    current_database_name="blog_writer_doc_$$"
  else
    current_database_name="blog_writer_doc_${package//-/_}_$$"
  fi

  docker compose exec -T db createdb \
    --username "blog_writer" \
    "$current_database_name"

  local database_url
  database_url="$(scripts/db-url "$package" dev)"
  database_url="${database_url%/*}/$current_database_name"

  (
    cd "$package"
    DATABASE_URL="$database_url" bash -c "$migration_command"
    TBLS_DSN="${database_url}?sslmode=disable" tbls doc --rm-dist -c .tbls.yml
    TBLS_DSN="${database_url}?sslmode=disable" tbls lint -c .tbls.yml
  )

  drop_database
}

run_db_doc 'backend' 'rust' << 'DB_MIGRATE'
cargo run -q -- --migrate-only
DB_MIGRATE
