#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

(
  cd "$repo_root/frontend"
  nr build
)

if [[ ! -f "$repo_root/frontend/dist/index.html" ]]; then
  printf 'frontend build did not produce frontend/dist/index.html\n' >&2
  exit 1
fi

exec cargo build --manifest-path "$repo_root/backend/Cargo.toml" --release "$@"
