#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

(
  cd "$repo_root/frontend"
  pnpm run build
)

if [[ ! -f "$repo_root/frontend/dist/index.html" ]]; then
  printf 'frontend build did not produce frontend/dist/index.html\n' >&2
  exit 1
fi

# rust-embed discovers assets during compilation, so Cargo may otherwise reuse an artifact built before dist existed.
touch "$repo_root/backend/src/frontend.rs"

cd "$repo_root/backend"
exec cargo build --release "$@"
